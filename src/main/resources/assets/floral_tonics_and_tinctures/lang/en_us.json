  "effect.floral_tonics_and_tinctures.prickly": "Prickliness",
  "effect.floral_tonics_and_tinctures.prickly.description": "This effect causes the affected entity to retaliate with thorns damage equal to the level of the effect whenever they are attacked.",
  "effect.floral_tonics_and_tinctures.purifying": "Purifying",
  "effect.floral_tonics_and_tinctures.purifying.description": "This effect cleanses any harmful potion effects from the affected entity. When the affected entity interacts with another mob or hits them with an attack, they will remove any potion effects from their target. If the affected entity interacts with one of their own tamed mobs, it will only remove harmful effects, leaving beneficial ones.",
  "effect.floral_tonics_and_tinctures.fiery": "Fiery",
  "effect.floral_tonics_and_tinctures.fiery.description": "This effect causes the affected entity to set its attackers and entities that it attacks on fire for a short time. It will also slowly smelt items that you hold in your hands, excluding weapons and armor.",
  "effect.floral_tonics_and_tinctures.frosty": "Frosty",
  "effect.floral_tonics_and_tinctures.frosty.description": "This effect causes the affected entity to build up frostbite on its attackers and entities that it attacks, and also allows you to freeze nearby water for a short time.",
  "effect.floral_tonics_and_tinctures.magic_resistance": "Magic Resistance",
  "effect.floral_tonics_and_tinctures.magic_resistance.description": "This effect grants you immunity to magical damage, and dispels certain magical entities that come into contact with you.",
  "effect.floral_tonics_and_tinctures.gold_rush": "Gold Rush",
  "effect.floral_tonics_and_tinctures.gold_rush.description": "This effect increases the effectiveness and reduces the durability loss of gold tools, armor, and equipment.",
  "effect.floral_tonics_and_tinctures.volatility": "Volatility",
  "effect.floral_tonics_and_tinctures.volatility.description": "This effect causes an explosion at the affected entity's location when it expires.",
  "effect.floral_tonics_and_tinctures.floral_scent": "Floral Scent",
  "effect.floral_tonics_and_tinctures.floral_scent.description": "This effect causes the affected entity to be surrounded by a pleasant scent that will pacify it, as well as entities that would normally target it. If the entity takes damage, or deals damage, this effect will be removed.",
  "effect.floral_tonics_and_tinctures.wayfaring": "Wayfaring",
  "effect.floral_tonics_and_tinctures.wayfaring.description": "This effect causes the affected entity to leave a trail of luminous golden leaves as they walk, which last for a very long time.",


